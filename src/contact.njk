---
layout: layouts/page.njk
title: Contact
permalink: /contact/
---
<div class="wrapper">
  <h1>Contact</h1>
  <p>Thinking about buying or selling in {{ business.address }}? Reach out for a no-obligation conversation.</p>
</div>
<dl class="contact-details wrapper">
  {% if business.phone %}
  <dt>Phone</dt>
  <dd><a href="tel:{{ business.phone }}">{{ business.phone }}</a></dd>
  {% endif %}
  {% if business.email %}
  <dt>Email</dt>
  <dd><a href="mailto:{{ business.email }}">{{ business.email }}</a></dd>
  {% endif %}
  {% if business.address %}
  <dt>Office</dt>
  <dd>{{ business.address }}</dd>
  {% endif %}
</dl>
<p class="wrapper agent-bio__license">{{ business.license }}<br>{{ business.disclaimer }}</p>

